# rdocs.cmake
#
# Regenerate man/ pages from roxygen2 comments.
# Invoked at build time via `cmake -P` by the `rdocs` custom target.
#
# Required variables (passed with -D from CMakeLists.txt):
#   R_EXECUTABLE       - path to the R interpreter
#   PATCHELF           - path to the patchelf utility
#   DA_LIB_DIR         - directory containing libaocl-da.so
#   DA_INCLUDE_DIR     - directory containing aoclda.h
#   PKG_CXXFLAGS       - compiler flags
#   PACKAGE_SOURCE_DIR - absolute path to the r_interface/ directory
#   BUILD_DIR          - absolute path to the CMake binary directory

message(STATUS "=== AOCL-DA R Documentation Generation ===")

# ── Validate ──────────────────────────────────────────────────────────────────

set(DA_LIB "${DA_LIB_DIR}/libaocl-da.so")

if(NOT EXISTS "${DA_LIB}")
  message(FATAL_ERROR
    "libaocl-da.so not found at '${DA_LIB}'.\n"
    "Build AOCL-DA first, or override with -DDA_LIB_DIR=<path>.")
endif()

if(NOT EXISTS "${DA_INCLUDE_DIR}/aoclda.h")
  message(FATAL_ERROR
    "aoclda.h not found under '${DA_INCLUDE_DIR}'.\n"
    "Override with -DDA_INCLUDE_DIR=<path>.")
endif()

# Check roxygen2 is available
execute_process(
  COMMAND "${R_EXECUTABLE}" --slave
          -e "if (!requireNamespace('roxygen2', quietly=TRUE)) quit(status=1)"
  RESULT_VARIABLE _rc
)
if(NOT _rc EQUAL 0)
  message(FATAL_ERROR
    "R package 'roxygen2' is required. Install with:\n"
    "  Rscript -e \"install.packages('roxygen2', repos='https://cloud.r-project.org')\"")
endif()

# ── Stage inst/include and inst/libs ──────────────────────────────────────────

set(INST_DIR     "${PACKAGE_SOURCE_DIR}/inst")
set(INST_INCLUDE "${INST_DIR}/include")
set(INST_LIBS    "${INST_DIR}/libs")

file(MAKE_DIRECTORY "${INST_INCLUDE}")
file(MAKE_DIRECTORY "${INST_LIBS}")

file(GLOB _headers "${DA_INCLUDE_DIR}/*.h" "${DA_INCLUDE_DIR}/*.hpp")
foreach(_hdr IN LISTS _headers)
  file(COPY "${_hdr}" DESTINATION "${INST_INCLUDE}")
endforeach()

file(COPY "${DA_LIB}" DESTINATION "${INST_LIBS}" FOLLOW_SYMLINK_CHAIN)

# Patch RPATH on bundled libs
file(GLOB _bundled "${INST_LIBS}/*.so*")
foreach(_lib IN LISTS _bundled)
  if(NOT IS_SYMLINK "${_lib}")
    execute_process(
      COMMAND "${PATCHELF}" --set-rpath "$ORIGIN" "${_lib}"
      ERROR_QUIET
    )
  endif()
endforeach()

# ── Generate src/Makevars ─────────────────────────────────────────────────────

if(R_CXX)
  set(_cxx_line "CXX = ${R_CXX}\nCXX17 = ${R_CXX}\n")
else()
  set(_cxx_line "")
endif()
file(WRITE "${PACKAGE_SOURCE_DIR}/src/Makevars"
"# Generated by cmake/rdocs.cmake -- do not edit manually.
${_cxx_line}CXX_STD = CXX17
PKG_CPPFLAGS = -I../inst/include
PKG_LIBS = -L../inst/libs -laocl-da -Wl,-rpath,'\$\$ORIGIN'
PKG_CXXFLAGS = ${PKG_CXXFLAGS} \$(SHLIB_OPENMP_CXXFLAGS)
")

# ── Install from source with --with-keep.source ──────────────────────────────

set(_tmp_lib "${BUILD_DIR}/_R_doclib")
file(MAKE_DIRECTORY "${_tmp_lib}")

message(STATUS "Installing package from source (with-keep.source) ...")
execute_process(
  COMMAND "${R_EXECUTABLE}" CMD INSTALL --with-keep.source
          -l "${_tmp_lib}" "${PACKAGE_SOURCE_DIR}"
  RESULT_VARIABLE _rc
)
if(NOT _rc EQUAL 0)
  file(REMOVE_RECURSE "${INST_DIR}")
  file(REMOVE "${PACKAGE_SOURCE_DIR}/src/Makevars")
  file(REMOVE_RECURSE "${_tmp_lib}")
  message(FATAL_ERROR "R CMD INSTALL --with-keep.source failed.")
endif()

# ── Run roxygen2 with the installed package ───────────────────────────────────

message(STATUS "Running roxygen2::roxygenize() ...")
execute_process(
  COMMAND "${R_EXECUTABLE}" --slave
          -e ".libPaths(c('${_tmp_lib}', .libPaths())); roxygen2::roxygenize('${PACKAGE_SOURCE_DIR}', load_code = roxygen2::load_installed)"
  RESULT_VARIABLE _rc
)
if(NOT _rc EQUAL 0)
  file(REMOVE_RECURSE "${INST_DIR}")
  file(REMOVE "${PACKAGE_SOURCE_DIR}/src/Makevars")
  file(REMOVE_RECURSE "${_tmp_lib}")
  message(FATAL_ERROR "roxygen2::roxygenize() failed.")
endif()

# ── Clean up ──────────────────────────────────────────────────────────────────

file(REMOVE_RECURSE "${INST_DIR}")
file(REMOVE "${PACKAGE_SOURCE_DIR}/src/Makevars")
file(REMOVE_RECURSE "${_tmp_lib}")
file(GLOB _build_artifacts "${PACKAGE_SOURCE_DIR}/src/*.o" "${PACKAGE_SOURCE_DIR}/src/*.so")
foreach(_f IN LISTS _build_artifacts)
  file(REMOVE "${_f}")
endforeach()

message(STATUS "")
message(STATUS "=== Documentation regenerated ===")
message(STATUS "Updated: ${PACKAGE_SOURCE_DIR}/man/")
message(STATUS "")

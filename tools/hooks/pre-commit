STYLE=$(git config --get hooks.clangformat.style)
if [ -n "${STYLE}" ] ; then
  STYLEARG="-style=${STYLE}"
else
  STYLEARG=""
fi

FILES_POLISHED=0
COPYRIGHT=0
OK=0

check_format_file() {
  local file="$STAGE_DIR/files/$1"
  if [ -f "$file" ] && [ ! -L "$file" ]; then
    # Keep repository style discovery while formatting only the staged bytes.
    if ! clang-format ${STYLEARG:+"$STYLEARG"} --assume-filename="$ROOT/$1" \
        < "$file" > "$STAGE_DIR/formatted"; then
      echo "ERROR: clang-format: Failed to format $1" >&2
      FILES_POLISHED=1
    elif ! diff -q -- "$file" "$STAGE_DIR/formatted" > /dev/null; then
      echo ERROR: clang-format: File "${1}" is NOT polished
      FILES_POLISHED=1
    fi
  fi
}

case "${1}" in
  --about|-h|--help)
    echo "pre-commit hook: Run clang-format, copyright checks on staged files."
    echo "Checks use temporary copies from the index; working files are not modified."
    exit 0
    ;;
esac

ROOT=$(git rev-parse --show-toplevel) || exit 1
cd "$ROOT" || exit 1
STAGE_DIR=$(mktemp -d) || exit 1
trap 'rm -rf -- "$STAGE_DIR"' EXIT
trap 'exit 1' HUP INT TERM

# NUL-delimited paths preserve spaces and newlines; deleted files have no content.
git diff --cached --name-only --diff-filter=d -z > "$STAGE_DIR/paths" || exit 1
mapfile -d '' -t STAGE_FILES < "$STAGE_DIR/paths"
if [ "${#STAGE_FILES[@]}" -eq 0 ]; then
    echo "No staged files to check."
    exit 0
fi
mkdir "$STAGE_DIR/files" || exit 1
git checkout-index --prefix="$STAGE_DIR/files/" -- "${STAGE_FILES[@]}" || exit 1
mkdir -p "$STAGE_DIR/files/tools" || exit 1
git show :tools/copyright_suppression.txt > "$STAGE_DIR/files/tools/copyright_suppression.txt" || exit 1

for file in "${STAGE_FILES[@]}"; do
    case "${file,,}" in
    *.cpp|*.cc|*.h|*.hpp) check_format_file "$file" ;;
    esac
done

# Check all the files for correct copyright headers
(cd "$STAGE_DIR/files" && bash "$ROOT/tools/check_copyright.sh" "${STAGE_FILES[@]/#/./}")
COPYRIGHT=$?

if [ "$FILES_POLISHED" -ne 0 ] ; then
    echo "Files not polished by clang-format:"
    clang-format --version
    echo "Polish files prior to committing."
fi
if [ "$COPYRIGHT" -ne 0 ] ; then
    echo "Check copyright text."
fi
OK=$((FILES_POLISHED + COPYRIGHT))
if [ "$OK" -ne 0 ] ; then
    echo -e "\nCOMMIT ABORTED: file(s) have issues.\n"
fi

exit $OK
